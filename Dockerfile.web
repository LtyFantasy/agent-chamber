FROM node:22-alpine AS builder
WORKDIR /app
ENV CI=true
# pnpm 11 构建期依赖状态校验关闭（原因见 Dockerfile.backend 同位注释，v1.69.0 冒烟实测）
ENV pnpm_config_verify_deps_before_run=false
# 构建期镜像源注入（可选，默认空=官方源；用法与实测数据见 Dockerfile.backend 同位注释）
ARG APK_MIRROR=
ARG NPM_REGISTRY=
RUN if [ -n "$APK_MIRROR" ]; then sed -i "s|dl-cdn.alpinelinux.org|$APK_MIRROR|g" /etc/apk/repositories; fi \
 && if [ -n "$NPM_REGISTRY" ]; then echo "registry=$NPM_REGISTRY" >> /usr/local/etc/npmrc; fi
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY pnpm-workspace.yaml package.json ./
COPY pnpm-lock.yaml ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
# 原生模块编译工具链：workspace 根 install 会触发 bcrypt 等原生模块的 install
# 脚本，其 node-pre-gyp 预编译包托管在 github releases，国内拉取偶发
# socket hang up 时会 --fallback-to-build 走源码编译，alpine 无 python3/make/g++
# 则 gyp configure 必炸（v1.51.3 冒烟 mcp 镜像同坑实证，2026-08-13）。
# 仅 builder 阶段需要，不进运行时镜像
RUN apk add --no-cache python3 make g++
# lockfile 已随仓导出，严格 --frozen-lockfile：回退只会掩盖 lockfile 漂移
RUN pnpm install --frozen-lockfile
COPY . .
# NEXT_PUBLIC_* 构建期内联：compose 通过 build.args 传入（默认 http://localhost:8743）
ARG NEXT_PUBLIC_API_URL=http://localhost:8743/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# 必须先构建 @agent-chamber/shared（web 依赖 workspace:*，其入口是编译产物 dist/；
# 干净克隆下 dist 不存在，直接 build web 会报 Module not found）——顺序同 Dockerfile.backend
RUN pnpm --filter @agent-chamber/shared build
RUN pnpm --filter @agent-chamber/web build

FROM node:22-alpine
WORKDIR /app/apps/web
ENV NODE_ENV=production
# 根 node_modules 提供完整的 .pnpm store；apps/web/node_modules 中的 symlink 通过 ../../../node_modules/.pnpm 解析
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/apps/web/.next ./.next
COPY --from=builder /app/apps/web/node_modules ./node_modules
COPY --from=builder /app/apps/web/package.json ./
COPY --from=builder /app/apps/web/next.config.js ./
COPY --from=builder /app/apps/web/public ./public
EXPOSE 8742
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "8742"]
