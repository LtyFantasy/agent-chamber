FROM node:22-alpine AS builder
WORKDIR /app
ENV CI=true
# pnpm 11 默认在 run/build 前做依赖状态校验（verify-deps-before-run=install）：
# COPY . . 之后 workspace 多出未参与过滤安装的 package.json，校验判定过期并触发整量重装，
# 慢网络下 280s 超时必炸（2026-08-28 v1.69.0 从零冒烟两次实测），故关闭。
# ⚠️ 关闭校验后「谁要被 build，谁的依赖就必须进下面的过滤安装集」——该校验曾为
# build-runner-bundle.sh 里的 roundtable-runner tsc 兜底自动装依赖（第三次冒烟实测：
# 关闭后 runner node_modules 缺失、TS18046 全炸），故 runner package.json 必须 COPY 进安装层。
ENV pnpm_config_verify_deps_before_run=false
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY pnpm-workspace.yaml package.json ./
COPY pnpm-lock.yaml ./
COPY apps/backend/package.json ./apps/backend/
COPY packages/shared/package.json ./packages/shared/
# backend 运行时依赖 roundtable-protocol（workspace:*，runner.gateway 直接 import）——
# 缺装缺编译则 backend tsc 产物 require 被改写成直指 .ts 源码的相对路径，容器启动必挂
# （2026-08-08 圆桌首发事故的 docker 版复现，v1.51.2 从零冒烟第五层 bug）
COPY packages/roundtable-protocol/package.json ./packages/roundtable-protocol/
# build-runner-bundle.sh（本文件尾部）要编译 roundtable-runner——verify-deps 关闭后
# 不再有自动安装兜底，runner 的依赖（含 devDeps 的 typescript）必须进过滤安装集
COPY packages/roundtable-runner/package.json ./packages/roundtable-runner/
# 原生模块编译工具链：bcrypt 的 node-pre-gyp 预编译包托管在 github releases，
# 国内拉取偶发 socket hang up 时会 --fallback-to-build 走源码编译，alpine 无
# python3/make/g++ 则 gyp configure 必炸（v1.51.3 冒烟 mcp 镜像同坑实证，
# 2026-08-13）。仅 builder 阶段需要，不进运行时镜像
RUN apk add --no-cache python3 make g++
# lockfile 已随仓导出，严格 --frozen-lockfile：回退只会掩盖 lockfile 漂移
RUN pnpm install --frozen-lockfile
COPY . .
# 必须先编译 shared 与 roundtable-protocol（workspace 依赖拓扑序），
# backend 运行时通过 workspace symlink 依赖其 dist
RUN pnpm --filter @agent-chamber/shared build
RUN pnpm --filter @agent-chamber/roundtable-protocol build
RUN pnpm --filter @agent-chamber/backend build
# 构建 runner standalone bundle（install-runner.sh / roundtable-runner.tar.gz）
# 与宿主机 deploy.sh 复用同一脚本，保证两种部署方式的资产同源同版本。
# 指南资产链：.dockerignore 放行 docs/integrations（chamber 布局，oss-export 导出件）
# 进构建上下文 → bundle 脚本 INTEGRATIONS_SRC 两级探测（外层 oss-docs 优先，
# 仓内 docs/integrations 兜底）→ dist-assets/integrations/ 随镜像分发，
# 自部署栈 /downloads/integrations/* 与宿主机 deploy.sh 产物同构（v1.52.0 闭环）。
# alpine 无 bash（v1.51.0 install.sh 从零冒烟实测 exit 127），bundle 脚本全身
# bashism（BASH_SOURCE/[[ ]]/pipefail），builder 阶段补装 bash 而非改写 POSIX
RUN apk add --no-cache bash
RUN bash scripts/build-runner-bundle.sh

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
# 保留 monorepo 目录结构，使 apps/backend/node_modules 中的相对 symlink 能正确解析到根 node_modules/.pnpm
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=builder /app/apps/backend/package.json ./apps/backend/
# 根 package.json 进运行时镜像：/health 的 version 解析（findRepoRoot 从 cwd /app 向上找
# monorepo 根 package.json 读 version）依赖它——缺失则 version 恒 'unknown'
#（v1.57.3 chamber 从零冒烟实证）；根 package.json 在 builder 阶段已随 lockfile COPY
COPY --from=builder /app/package.json ./package.json
# runner bundle 资产（downloads controller DOWNLOADS_DIR 缺省 = WORKDIR/dist-assets）
COPY --from=builder /app/dist-assets ./dist-assets
EXPOSE 8743
CMD ["node", "apps/backend/dist/apps/backend/src/main"]
