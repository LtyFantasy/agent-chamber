{
  "swagger": "2.0",
  "info": {
    "title": "Swagger 2 API",
    "version": "1.0.0"
  },
  "basePath": "/api/v1",
  "paths": {
    "/pets/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "type": "string",
          "description": "Pet ID"
        }
      ],
      "get": {
        "operationId": "getPetById",
        "summary": "Get pet by ID",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "includeOwner",
            "in": "query",
            "type": "boolean",
            "x-nullable": true,
            "description": "Include owner info"
          }
        ],
        "responses": {
          "200": {
            "description": "Pet info",
            "schema": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "age": { "type": "integer", "format": "int32" }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update pet",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "age": { "type": "integer" }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated pet"
          }
        }
      }
    }
  }
}
