# AI Agent Chamber 协作平台 — 环境变量模板
# 复制为 .env 后按需修改，切勿提交到 git

# 运行时环境
NODE_ENV=production

# 后端服务端口
PORT=8743

# CORS 允许的来源（可选）
# 不设置 = 放行所有来源（origin:true，默认行为）；
# 生产收紧时填逗号分隔白名单，如：CORS_ORIGINS=https://platform.example.com,https://admin.example.com
# CORS_ORIGINS=

# 构建期镜像源（可选，默认空=官方源）
# docker compose 构建时注入 alpine/npm 镜像；setup.sh 探测到官方源不可达/过慢会自动回落写入。
# APK_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com

# PostgreSQL 数据库（Docker 内网）
# 注意：DB_PASSWORD 是单一事实来源。首次启动后数据卷已固化初始密码，之后修改本值
# 必须同步数据库内密码，否则后端会因密码不一致而无法启动：
#   docker exec -it <postgres容器名> psql -U <DB_USERNAME> -d <DB_DATABASE> \
#     -c "ALTER USER \"<DB_USERNAME>\" PASSWORD '<新密码>';"
# 数据库主机：Docker Compose 部署时由 compose 环境变量自动覆盖为服务名 postgres，此处默认值面向宿主机直连/非 Docker 部署
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=chamber
DB_PASSWORD=chamber_password
DB_DATABASE=agent_chamber
# 数据库连接是否启用 SSL（默认 false；生产环境连接外部托管 PG 时通常需设为 true）
DB_SSL=false

# MinIO 对象存储（媒体附件；Docker Compose 部署时 backend 容器的 MINIO_ENDPOINT/PORT
# 由 compose 自动覆盖为服务名 minio:9000，此处默认值面向宿主机直连/非 Docker 部署）
# MINIO_ACCESS_KEY/SECRET_KEY 同时是 compose 中 minio 容器的 root 凭据（MINIO_ROOT_USER/
# PASSWORD 同源插值）——生产环境必须修改为强随机值，占位值禁止上生产
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_root_user
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=agent-chamber-attachments

# JWT 密钥（生产环境必须修改！）
JWT_SECRET=change-me-to-a-random-32-char-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-to-a-random-32-char-string-refresh
JWT_REFRESH_EXPIRES_IN=7d

# 附件短时签名 URL（P2 批 2）——独立签名密钥，生产必须强随机（`openssl rand -hex 32`）
# 说明：这是**与会话 JWT 不同的**凭证族，生产环境设成与 JWT_SECRET 同值会被拒绝启动
# （fail-fast：共享签名钥会让附件 token 在会话守卫处签名合法，密钥隔离防线消失）；
# 占位值/缺失同样在生产启动期拒绝。
ATTACHMENT_URL_SECRET=change-me-to-a-random-32-char-string-attachment-url
# 未显式指定 ttlSeconds 时的签名 URL 默认有效期（秒，默认 300；文档化区间 60~3600）
ATTACHMENT_SIGNED_URL_TTL_DEFAULT=300

# 接口/MCP 调用频率统计（usage stats）——内存聚合的定期落库间隔（毫秒，默认 60000）
# rationale：统计在内存按 UTC 小时桶聚合（api_usage_stats_hourly），本值决定
# "进程被强杀/crash 时最多丢多少计数"（60000 ≈ 最多丢一个窗口）。
# 低于 1000 或不可解析的取值一律回落 60000（防误配 0 退化成忙循环）。
USAGE_FLUSH_INTERVAL_MS=60000

# 仅首次启动且系统无 admin 用户时生效；不设置则不创建管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Platform API（可选；仅主仓库内部脚本 scripts/sync-docs.mjs / report-metrics.mjs / report-deploy.mjs / report-release.mjs 使用，自部署无需配置）
# PLATFORM_API_KEY：Agent API Key（X-API-Key 认证）；不设置仅文档同步/指标上报/部署记录上报/快照归档不可用，不影响其他功能
# PLATFORM_API_KEY=
# 平台 API 基础地址（默认本地开发后端）
PLATFORM_BASE_URL=http://localhost:8743/api/v1
# 上报目标 board（scripts/report-deploy.mjs 部署记录与 scripts/report-metrics.mjs 测试基线的目标 board，release milestone 所在）
# 不设置时需显式传 --board-id <uuid>
# PLATFORM_BOARD_ID=
# 快照归档目标 DocSpace（scripts/report-release.mjs release digest 快照归档的目标空间，与 sync-docs.mjs 共用）
# 不设置时需显式传 --space-id <uuid>
# PLATFORM_DOCSPACE_ID=

# ─── 经验库判别服务（可选；缺省关闭）─────────────────────────────────────────
# 用途：录入/内容改写后对条目做**七维软判定**（完整度/可复用性/信号质量/重复度/类型归类/
#   领域归类/准入建议）。**observe 期：只标注不拒绝**——判定失败、超时、被限流都不影响
#   录入成功（fail-open）。
#
# ── 想启用？两步（改完必须重建容器才生效）──
#   ① 把下面唯一的 `JUDGMENT_PROVIDER=none` 改成 `JUDGMENT_PROVIDER=typesafe`；
#   ② 把紧随其后的 `# TYPESAFE_API_KEY=` 取消注释并填入你的官方 key
#      （申请入口 https://console.typesafe.ai/keys）。
#   然后重建后端容器：`docker compose up -d backend`
#   （`docker compose restart backend` **不重读 .env**——改了却不生效就是这个原因）。
#   ⚠️ 只在**同一处**改这两行：同名键后者胜，另起一行再写一个 JUDGMENT_PROVIDER 会让你的
#      修改被文件末尾那一行静默覆盖（功能仍是关的，且没有任何提示）。
#
# ⚠️ 启用 = **条目文本出境**：标题 / 摘要 / 正文节选（≤2000 字符）/ 信号 / 领域 / 环境指纹 /
#   疑似重复候选（**其他条目的 id、标题与 quality**）都会发往 TypeSafe 官方云 API——
#   这部分流量会离开你的网络。
#
# JUDGMENT_PROVIDER：none（缺省，完全关闭：不调用、不写日志、不占额度）| typesafe
#   - 非法/缺失值一律视为 none（判别是增强项，配置错误不阻断启动）
#   - 旧版本用过的 `jev`（自托管 MCP 网关适配器）**已在 v1.83.0 退役**：填它会落 none，
#     后端启动打一行 warn 提示（网关相关的旧配置键一并作废，删掉即可）
#   - ⚠️ **只写本键、不写对应 key ⇒ production 后端启动即崩**（dev/test 降级 none 并 warn 一行）
#
# ── typesafe（TypeSafe 官方云 REST）──
# TYPESAFE_API_KEY：官方 key（申请入口 https://console.typesafe.ai/keys；**只在后端 env**，
#   不进库、不进日志、不进响应）
# TYPESAFE_BASE_URL：官方 **API 根**（缺省 https://api.typesafe.ai）——**勿带 /v1，否则 404**
#   （后端自己拼 /v1/systemone；生产环境必须是 https，仅 localhost/127.0.0.1 允许 http）
# TYPESAFE_DEFAULT_MODEL：请求模型（缺省 jev-latest；空串回落缺省）
#   - ⚠️ `jev-latest` / `jev-1.13.0` 是 **TypeSafe 官方模型名**，与已退役的 jev 网关适配器
#     **无关**（命名巧合，别据此以为还要配 jev 相关的键）
#   - `jev-latest` 是**浮动别名**，随官方发版漂移；跨批次可比性要求高时钉版本 ID（如 jev-1.13.0）
#   - 它只是**请求参数**：日志与条目快照里的 model 恒取上游响应自报值
#
# ── 出口代理（可选；**只改判别流量的道**，不影响 webhook / 飞书等其他出境）──
# TYPESAFE_HTTPS_PROXY / TYPESAFE_HTTP_PROXY：专用代理 URL（如 http://proxy.internal:8001，
#   可带 userinfo 基本认证）。按 TYPESAFE_BASE_URL 的 scheme 选键：https 端点读 HTTPS 键。
#   - 用途：官方 API 在部分地区直连返回 HTTP 451（地区不可用）时，把判别流量改走自建代理出口
#   - **不读全局 `HTTP_PROXY`/`HTTPS_PROXY`**——避免一个键把全部出境流量静默改道
#   - 缺省不设 = 直连；空串视同未配置；非法值回落直连并打一行 warn（值永不进日志）
#   - 生效自检：启动 INFO `entry judgment ENABLED` 同行会打 `proxy=<host:port>`
#   - ⚠️ **容器可达性**：示例若写 `http://127.0.0.1:8001`，在 docker-compose 容器里指向的是
#     **容器自己**（不是宿主机）——代理跑在宿主机时应写 `http://host.docker.internal:8001`
#     （Linux 需 compose 加 `extra_hosts: ["host.docker.internal:host-gateway"]`）或代理所在
#     容器的服务名/内网地址；生产宿主机直跑（systemd，无容器）时 `127.0.0.1` 才是本机
#
# ── 共用旋钮：三级成本闸（都按**每实例每滑动小时**计数，任一级超限即跳过）──
# JUDGMENT_TIMEOUT_MS：单次判定硬顶（缺省 8000；非法值回落缺省）
#   - 客户端（MCP/脚本）超时必须 ≥10s 且重试复用同一 clientRequestId，否则会把成功录入看成失败
# JUDGMENT_RATE_LIMIT：单 actor 每小时判定额度（缺省 60；create 与 update 判定共用；
#   被限流的尝试同样写一行 status=skipped 日志并计入额度——**actor 桶连被拒尝试一起计**
#   （与两级共享桶相反：不许当免费通道））
# JUDGMENT_GLOBAL_RATE_LIMIT：**全局总闸**（缺省 240/h/实例，跨 actor）——防单 actor 之外的
#   放大（脚本 bug / 重放 / 批处理）。两级共享桶**只计放行**（被拒尝试不占位）⇒ 连续刷也钉不满
#   额度、窗口滑过即恢复；配合能力子额度（≤ 本闸）保证单一能力吃不满全局预算
# JUDGMENT_CAPABILITY_RATE_LIMIT：**单能力子额度**（缺省 120/h/实例；本版能力 = `record_check`
#   + `rerank`，即"经验库录入判定"与"文档搜索重排"）——
#   为后续能力（如文档搜索 rerank）预留隔离位：每个能力最多消耗自己的子额度，故"某能力流量吃光
#   全局、饿死其他能力（如经验库判定这类不可再生语料）"不会发生（前提 = 各子额度 ≤ 全局闸）。
#   **应 ≤ JUDGMENT_GLOBAL_RATE_LIMIT**；两个额度键**高于全局闸**时该级永不生效，后端启动各打
#   一行 warn 点明（键配反了不静默）
#   - 数值键（三个额度 + 超时）写错（NaN / 非正数）一律回落缺省，并在启动打一行 warn；
#     **空串 / 纯空白视同"未配置"**（回落缺省、不告警）——compose `${VAR:-}` 注空串的误报守卫
#
# JUDGMENT_CAPABILITIES：**受管辖能力的白名单**（逗号分隔；**缺省空集**）。
#   - 缺省空 = 除「经验库录入判定」外**一切能力都关**（出境类功能的唯一可接受缺省）
#   - 经验库录入判定（`record_check`）**恒启用、不受本键管辖**（它由 JUDGMENT_PROVIDER 单独管辖；
#     在本键里列它只会得到一条 warning）
#   - 当前可开启的能力：`rerank`（DocSpace 文档搜索重排）
#   - 拼错 / 未实现的名字被丢弃并打一行 warn（名字经净化：去控制字符、截断、key 形态脱敏）
#   - 配了能力却 JUDGMENT_PROVIDER=none ⇒ 所有能力都不生效（启动打一行组合 warn 点明）
#   - ⚠️ **启用 = 该能力的数据出境**（发往 TypeSafe 官方云 API）。逐能力**出境字段 + 触发者**
#     如下（与后端启动 INFO 逐能力行、生产 fail-fast 文案同源）：
#       · `record_check`（经验库录入判定；恒启用、不受本键管辖）
#           出境字段：条目标题 / 摘要 / 正文节选（≤2000 字符）/ 信号 / 领域 / 环境指纹 /
#                     疑似重复候选（**其他条目的 id、标题与 quality**）
#           触发者  ：录入或改写经验条目时
#       · `rerank`（DocSpace 文档搜索重排）
#           出境字段：**搜索查询词** + 最多 50 行候选（每行 = 节标题 + ≤240 字节节选；
#                     不含 docId / docPath / position）
#           触发者  ：**agent 发起**的 DocSpace 搜索，且 sort=relevance、且落在重排翻页窗口内。
#                     ⚠️ 窗口判据（以代码为准）：`offset % limit === 0` **且**
#                     `offset + limit ≤ min(limit + 10, 50)`——limit=5 覆盖 offset 0/5/10，
#                     limit=20 只覆盖 offset=0；窗外页按 SQL 序返回。web（JWT）与人类调用不受影响
#
# ⚠️ **软闸语义**（别当成账单硬承诺）：三个计数器都是**进程内内存**——每实例独立、**重启清零**、
#   **多副本部署实际总上界 ×N**（无共享存储）。它们挡的是异常风暴（脚本 bug / 重放 / 单 actor
#   刷量），不是精确计费。
#
# 成本：`typesafe` 按**输入 token** 计费（官方定价见 https://docs.typesafe.ai/models）。
#   - **三个额度取更严者**决定出境量上限：单 actor 每小时最多 ≈ 最严闸值次判定 × 单次体量
#     （标题 + 摘要 + 正文节选 ≤2000 字符 + 信号 + 领域 + 环境指纹 + 疑似重复候选）——
#     调低任一级即调低账单上限；录入侧 30/h/actor 是间接封顶；内容改写（PATCH）没有独立限流
#   - 全局与能力级闸按**实例**计数：多副本部署时账单上限相应放大（见上"软闸语义"）
#
# ── 生效自检与排障（启用后按这几步对号入座）──
#   ① 生效自检：`docker compose logs backend | grep "entry judgment ENABLED"`
#      有这行 = 判别已启用（并打印解析后的端点）；没有 = 没生效（先看上面"重建容器"那条）。
#   ② 看不到结果 ≠ 没跑：判别是 fail-open，失败不报错；条目详情页的「机器初评（观察期）」
#      面板显示 `—` 只表示"该项无结论"，不代表判别没有执行。
#   ③ 判别失败逐项对号入座——用 admin 账号取 token 再查失败标签（无 jq 就去掉 `| jq ...` 看原 JSON）：
#        TOKEN=$(curl -s -X POST http://localhost:8743/api/v1/auth/login \
#          -H 'Content-Type: application/json' \
#          -d '{"email":"<admin 邮箱>","password":"<admin 密码>"}' | jq -r .data.accessToken)
#        curl -s -H "Authorization: Bearer $TOKEN" \
#          'http://localhost:8743/api/v1/experiences/judgments?status=error' \
#          | jq '.data.items[].response.error'
#      - `HTTP 401` / `rejected the credential` → key 无效或已被重置，去 console 重取一把
#      - `HTTP 404` → TYPESAFE_BASE_URL 多带了 `/v1`（去掉后重建容器）
#      - `timeout` → 网络抖动或上游慢，**重新录入即可**（失败不影响条目本身）
#
# ── FAQ（三句）──
#   - 保持 none 会少什么？经验库的**录入 / 检索 / 评审完全可用**，只是没有机器初评标注。
#   - 账单算谁的？算在**你自己的 TypeSafe 账号**上（key 是你申请的）。
#   - 改写条目（PATCH）超限会怎样？会清掉该条目的旧机器初评快照（旧结论描述的是旧内容）。
JUDGMENT_PROVIDER=none
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_HTTPS_PROXY=
# TYPESAFE_HTTP_PROXY=
JUDGMENT_TIMEOUT_MS=8000
JUDGMENT_RATE_LIMIT=60
JUDGMENT_GLOBAL_RATE_LIMIT=240
JUDGMENT_CAPABILITY_RATE_LIMIT=120
JUDGMENT_CAPABILITIES=

# ─── Memory 模块（Hument 集成一期；**可选增强，缺省关闭**）────────────────────────
# 用途：把项目内的裁决/拍板形成**可召回记忆**（Chamber ↔ Hument Hub，HTTP loopback）。
#   ⚠️ 可选增强：不配置（缺省 `none`）时 Chamber **完全可用**——引擎动词端点返回结构化
#   「memory 不可用 + 原因」（`MEMORY_UNAVAILABLE(14000)`），本地数据端点（项目 / 账本 /
#   详情 / 召回结果装配）照常工作。
#
# ── 想启用？三步 ──
#   ① 把下面唯一的 `MEMORY_ENGINE=none` 改成 `MEMORY_ENGINE=hument`；
#   ② 填 `HUMENT_BASE_URL`（**生产必填**；本机 dev 可省 ⇒ 回落 http://127.0.0.1:8099）；
#   ③ 在平台上给目标项目绑定引擎（workspace_id / actor_id / credential_ref）——
#      未绑定的项目仍会得到「本项目未绑定引擎」的结构化原因。
#   改完必须重建后端容器：`docker compose up -d backend`（`restart` **不重读 .env**）。
#
# MEMORY_ENGINE：none（缺省，完全关闭）| fake（**仅测试/e2e**）| hument
#   - 非法/缺失值一律视为 none（memory 是增强项，配置错误不阻断启动；启动打一行 warn）
#   - `fake` 是进程内确定性引擎（不联网、结果可复现）：**仅 test/e2e 使用**。
#     production 下填它**启动即崩**；它也不会落库（memory_projects.engine 值域只有 none|hument）
#   - production + `hument` 但缺 `HUMENT_BASE_URL` ⇒ **启动即崩**（缺省 loopback 只是本机便利，
#     生产静默指向它 = "以为接了 Hub 其实没接"，每次调用白等一轮超时后落 unknown）
#
# HUMENT_BASE_URL：Hub 端点（缺省 http://127.0.0.1:8099）
#   - 只填 `协议://主机:端口`，**不含路径**（后端自己拼 /v1/memory/nominations 等 6 个端点）
#   - 本机 dev 用 http 即可；跨机部署请把 Hub 放在可信网络内（凭据引用随请求头出行）
#
# HUMENT_TIMEOUT_MS：单次调用**客户端硬顶**（缺省 90000；非法值回落缺省；≥120000 回落缺省并 warn）
#   - **超时不等式（调参前必读）**：
#       `HUMENT_TIMEOUT_MS ≥ 2 × <Hub 侧 provider timeout> + 余量`  且  `HUMENT_TIMEOUT_MS < 120s`
#     缺省 90000 对"dev 建议的 Hub provider timeout 25000"成立：2×25000 = 50000，余 40000ms。
#   - 为什么必须有这个不等式：**Hument 服务端没有写超时**。客户端先放弃而服务端仍在跑时，
#     我们既拿不到回执、也无法回滚这一次形成 ⇒ 该提名落 `unknown`（**Chamber 不可恢复**，
#     只能同 key 重发让引擎侧 replay 推进，或走运维 recovery）。
#   - 所以：调低客户端超时**必须同步调低 Hub 侧 provider timeout**；反过来把 provider timeout
#     调低会升高 `unknown` 出现率（dev 建议 25000，别更低）。
#   - 客户端（MCP 工具 / 脚本）自己的超时必须 ≥ 本值，否则会在服务端仍在等待时先断开
#
# ── 自助开通（二期；**可选，缺省关闭**）──────────────────────────────────────────
# 用途：把"新建 memory 项目时必须手工在 Hub 上 add binding"从运维步骤变成后端自动完成——
#   建项目**不传**引擎三键（engineWorkspaceId/engineActorId/engineCredentialRef）时，后端经
#   launcher Unix socket 取一次性 code → 换 operator session cookie → 调 Hub 在线注册面
#   一次登记 workspace/actor/credential_ref/binding，并把**派生的三键**落库。
#   ⚠️ 三键**全显式**时仍走手工老路（零注册调用）；**部分缺**仍是 400（现状不变）。
#
# HUMENT_PROVISIONING_ENABLED：true | 其它（缺省 = 关闭；非 `true` 一律视为关闭）
#   - production + true 但缺 HUMENT_OPERATOR_SOCKET_PATH ⇒ **启动即崩**（"以为开着其实没开"的
#     静默降级比启动崩更难排）；dev/test 降级为一条 warning + 自动注册不可用
#   - 需与 MEMORY_ENGINE=hument 同用（自动注册只在 engine=hument 的创建分支可达）
#
# HUMENT_OPERATOR_SOCKET_PATH：Hub launcher 控制 socket 的**绝对路径**
#   - 形如 `<hub root>/run/hument-control.sock`（Hub 侧 0600，仅本机可读；见 DEPLOY.md）
#   - Hub 侧须以 `--operator-binding <manager binding id>` 启动，并预置该 manager binding
#
# HUMENT_OPERATOR_BINDING_ID：manager binding id（缺省 binding-ops-chamber）
#   - 运维在 Hub 一次性预置（`binding add --id binding-ops-chamber --credential-ref ... 
#     --capabilities inspect_read,catalog_project_register`）；不随项目变化
#
# HUMENT_PROVISIONING_TENANT_ID：注册体 tenant_id（缺省 chamber；dev 常用 chamber-dev）
#   - ⚠️ **没有 credential_ref 键**：凭据引用**按项目派生**（`ref-<slug>`）。Hub 侧
#     `hument_catalog_credential_references.credential_ref` 是**主键** ⇒ 与注册 1:1，
#     部署级共享一个 ref 会让第二个项目必然 409。派生值以 `ref-` 开头、且是目录引用
#     （neutral adapter 不解析成实际端点凭据）⇒ **无需在 credentials.env 预置**。
#
#   ⚠️ 回滚陷阱：Hub 侧加了 [project_registration] enabled = true 后，旧二进制会因
#     DisallowUnknownFields 拒载——回滚 Hub 必须连 config 快照一起回滚（见 DEPLOY.md）。
#
# ── 引擎运行时告警（卡 26c43f52 / 5e6cb000；**可选，缺省只进日志**）──────────────────
# 用途：引擎「已配置但连续失败」时，把告警**推送给 admin 账号绑定的通信渠道**
#   （notify 的 `system_alert` 类别；路线 B = 非用户可配、唯一治理面是部署级 NOTIFY_ENABLED），
#   恢复时再发一条恢复通知。**agent / 探针主动查询**走 `GET /v1/health/ready` 的
#   `optional.memoryEngine`（disabled / down / degraded / unknown / up 五态告警视图）。
#   未投递（NOTIFY_ENABLED=false / 无 admin 渠道 / 渠道不可投递…）时只剩结构化日志——
#   这就是"没配置就落日志"的兜底形态，**不需要、也不再支持配置告警话题**。
#   判据双臂：A = 可用性（业务调用连续 5 次失败 / 就绪探测连续 3 次失败 / 3 次且 5 分钟），
#             B = 认证与绑定（401/403 连续 5 次；**业务调用恢复**才发恢复）。
#
# MEMORY_HEALTH_PROBE_ENABLED：true（缺省）| false
#   - 控制 `GET /v1/health/ready` 就绪探测（每 120s，5s 短超时，**免鉴权**）
#   - **关掉探针不等于关掉告警**：业务流量判据与时间窗求值照常（否则关探针会连恢复通知都发不出）
#   - 关掉它的场景：Hub 探活已由运维侧负责、不希望平台再打点
#
# ── 生效自检 ──
#   `docker compose logs backend | grep "memory engine ENABLED"`：有这行 = 引擎已装配
#   （行内打印解析后的端点与超时）；没有 = 没生效（先看上面"重建容器"那条）。
#   `docker compose logs backend | grep "memory provisioning"`：有这行 = 自动注册已装配。
#   `docker compose logs backend | grep "system_alert target"`：系统告警的收件人解析结果
#   （disabled / ok / 六种断态，断态带修复指引）。
#   `docker compose logs backend | grep "category=system_alert"`：逐条告警的投递结局。
#   `docker compose logs backend | grep MEMORY_ENGINE_ALERT`：告警/恢复/心跳/派发失败的日志行。
#   `docker compose logs backend | grep "engine health view"`：健康视图装配状态
#   （engine=assembled|none probe=on|off）。
MEMORY_ENGINE=none
# HUMENT_BASE_URL=http://127.0.0.1:8099
# HUMENT_TIMEOUT_MS=90000
# HUMENT_PROVISIONING_ENABLED=false
# HUMENT_OPERATOR_SOCKET_PATH=
# HUMENT_OPERATOR_BINDING_ID=binding-ops-chamber
# HUMENT_PROVISIONING_TENANT_ID=chamber
# MEMORY_HEALTH_PROBE_ENABLED=true

# ─── Notifications 模块（外部 IM 通知出口，一期）────────────────────────────────
# 用途：把平台内的事件（任务完工 / 指派 / 话题新消息 / 文档变更）与 agent 的主动请求，
#   经**飞书自建应用私聊**推给 Owner——手机点通知深链直接落回平台页面。
#
# ⚠️ **这是出境功能**：启用后下列字段会离开本机网络（与代码里 `NOTIFY_EGRESS_FIELDS`
#   声明逐项对齐；**新增外发字段必须同 commit 改那份声明**）：
#     · 任务标题（截断 200）+ 看板名 + 操作者显示名（正文 `看板「…」 · <操作者>`，指派类追
#       `→ 指派给 …`；正文截断 200）—— 任务事件（完工 / 创建 / 更新 / 指派）
#     · 文档路径（截断 200）+ 空间名 + 标题（正文 `空间「…」 · <标题>`，正文截断 200）
#                             —— 文档事件（创建 / 更新 / 删除 / 移动）
#     · 话题名                —— 话题事件（他人新消息）
#     · 发言人显示名 + 消息摘要（截断 100）—— 话题事件（正文 `<发言人>：<摘要>`）
#
#   宽度分三层（各自服务不同语义，不是数据库约束——`body` 列是 text）：
#     topic 100 = **预览**（读全文点深链）；task / doc 200 = 归属信息是**消息本体**，
#     截掉尾巴这条通知就失去意义；direct 2000 = agent 自填。
#     · 直发正文（由 agent 自填，≤2000 字符）—— 直发端点
#     · agent 显示名（直发消息的 `[<名字>]` 前缀）—— 直发端点（让你知道是谁在找你）
#     · 摘要（L2 超额汇总：被限流窗口压下的**条数按类别计数** + web 根链接）—— 批量刷屏时的那一条汇总
#     · 深链（NOTIFY_WEB_BASE_URL + 资源路径）—— 每个事件
#   **默认关闭**（`NOTIFY_ENABLED=false`）：未配置时平台行为与没有本模块完全一致——
#   这不只是"省事缺省"，是出境功能唯一可接受的缺省。
#
# ── env 键（逐键）──
# NOTIFY_ENABLED：true | 其它（缺省 = **关闭**；非 `true` 一律视为关闭，与 DB_SSL 同口径）
#   - false ⇒ **一切静默**：不校验任何键、不发任何通知、不落任何投递记录。
# NOTIFY_CATEGORIES：逗号分隔的细粒度类别白名单（缺省 `task_done,direct`）
#   值域与语义（**映射判据在代码里，此处只列名字**）：
#     task_done     任务完工/阻塞**跃迁**（状态真的变了才算；改一个已完成任务的描述**不推**）
#     task_created  任务创建
#     task_updated  任务其余更新（改标题/描述/优先级…；**不含**完工判定）
#     task_assigned 任务指派（web/PATCH 改派 与 API /assign 两条路径各发各的）
#     topic         你参与的话题里他人发了消息（自己发言、system 消息不推）
#     doc_created / doc_updated / doc_deleted / doc_moved  文档四类（纯重切的内容更新会短路）
#     direct        agent 主动直发（`POST /api/v1/notifications/messages`）
#   非法 token 会被忽略并打一条 warning（不阻断启动）。
#   **推荐组合**：
#     · "只看完工"（最低噪音）：`task_done`
#     · "管看板"（看板负责人）：`task_created,task_done,task_assigned`
#     · ⚠️ **全开会被 L2 压成摘要**：全局窗口默认 5 条/10 分钟，超出的会被合并成一条
#       「另有 N 条通知（类别分布）」——活跃项目上全开 ≈ 只收到汇总，不是"每件事都提醒你"。
# NOTIFY_PROVIDERS：逗号分隔的出口白名单（值域：`feishu`；缺省空 = 无出口）
#   未知 token 忽略 + warning；开着通知却没有出口 ⇒ 每次投递都被**丢弃**（日志里一行
#   `dropped [no_provider]`，且**不写投递表**——没有出口就没有投递尝试，别去表里找失败行）。
# FEISHU_APP_ID / FEISHU_APP_SECRET：飞书自建应用凭据（缺省空）
#   - 应用需开启**机器人能力** + `im:message` + `im:message:send_as_bot` 并发布版本
#   - ⚠️ `FEISHU_APP_SECRET` 是凭据：**不入库、不上云、不 commit**（放本地安全通道）
# FEISHU_RECIPIENT_OPEN_ID：**二期起 = 播种源**（缺省空；不再是"收件人"）
#   - 二期通知收件人来自每个用户自己的**渠道绑定**（Web：Settings → 通知），不再是部署级单值
#   - 本键现在只被 **D4 播种**消费：进程启动时若 `ENABLED ∧ 飞书三键齐 ∧ 本键非空 ∧
#     NOTIFY_OWNER_USERNAMES 恰好 1 人`，就把该用户与该地址**预绑一次**（`source='env_seed'`，
#     投递资格等同已验证但徽标显示「已导入·未验证」）——升级日不让存量用户静默断流
#   - ⚠️ **陷阱**：填了本键却**不填** `NOTIFY_OWNER_USERNAMES`（或填了 ≥2 人）会让播种
#     `skipped_no_source` / `skipped_ambiguous`；其中 `skipped_no_source` 在 production **启动即崩**
#     （有地址无归属 ⇒ 宁可显式报错，也别让"以为迁移好了"的部署静默全灭）
#   - 播种**永不复活**：用户解绑过的渠道有 tombstone 行，播种判据对它恒假，重启也不会重绑
#   - 自助获取两条路：① 给机器人私聊发一句话（侧台临时日志能看到 open_id）；
#     ② 用手机号换：飞书开放平台 `contact/v3/users/batch_get_id`（需 `contact:user.employee_id:readonly`）
#   - open_id 是**应用维度**的标识符：换应用要重新获取
# NOTIFY_OWNER_USERNAMES：**D4 播种源**（你的平台 username，逗号分隔；缺省空）
#   - 一期用途（自回声抑制 / 话题参与判定）在批 1 仍生效；二期多用户路由落地后用途收敛为播种
#   - 启动时解析成 actorId 并打一行 INFO `owner actors resolved n/N`（可 grep 自检）；
#     未命中的 username 逐个 warning（拼错与已软删的处置相同：都不生效）
#   - ⚠️ **二期起不再**因为"开了 `topic` 类别却没配本键"而 fail-fast（收件人来自用户绑定）；
#     但**播种**判据要求"恰好 1 人"，故配合 RECIPIENT_OPEN_ID 使用时必须只填一个
# NOTIFY_WEB_BASE_URL：通知深链的拼接基址（缺省空；如 `https://platform.example.com`）
#   - ⚠️ 与 `CORS_ORIGINS` 是**两个面**，不可互替：CORS_ORIGINS 管"浏览器允许哪些来源"，可以留空；
#     本键管"通知里的链接往哪拼"，**留空 ⇒ 通知没有链接**（手机点不开 = 失去"最后一厘米"）
#   - 尾斜杠会被自动剥掉；拼出的路径形如 `/tasks/<id>` `/topics/<id>` `/docs/<id>`
# NOTIFY_TASK_THROTTLE_SECONDS：同一任务的 L1 节流窗口（缺省 300）——四类任务通知共用一个值
# NOTIFY_DOC_THROTTLE_SECONDS：同一文档的 L1 节流窗口（缺省 600）——四个文档类别共用
# NOTIFY_TOPIC_THROTTLE_SECONDS：同一话题的 L1 节流窗口（缺省 600）
# NOTIFY_GLOBAL_RATE_LIMIT：L2 全局滑动窗口的条数上限（缺省 5）——超出的合并成一条摘要
# NOTIFY_GLOBAL_RATE_WINDOW_SECONDS：L2 窗口长度（缺省 600 = 10 分钟）
# NOTIFY_DIRECT_RATE_LIMIT_PER_WINDOW：agent 直发的入口闸（缺省 6；与 L2 分开记账）
# NOTIFY_DIRECT_RATE_WINDOW_SECONDS：agent 直发窗口长度（缺省 600）
# NOTIFY_PLATFORM_RATE_LIMIT：**部署级出境总闸**（二期新增；缺省 20）——整个部署窗口内
#   最多投递多少条（跨所有渠道、所有用户）。它挡的是"把外部配额/账单打穿"，与 per-user 的
#   L2（别把某个人的手机刷爆）是两种粒度。⚠️ 启动会自检 `总闸 < L2 × 已启用绑定数` 并 WARN
#   （N≥5 个活跃绑定用户时总闸会先于 per-user L2 生效，摘要机制被架空）
# NOTIFY_PLATFORM_RATE_WINDOW_SECONDS：部署级总闸窗口长度（二期新增；缺省 600）
# NOTIFY_HTTP_TIMEOUT_MS：provider 单次请求超时（缺省 8000 毫秒）
# NOTIFY_SYSTEM_ALERT_MAX_PER_HOUR：系统告警的每小时上限（告警通道；缺省 12，**按臂分桶**）
#   - 收件人 = **admin 账号**绑定的渠道（不是 NOTIFY_OWNER_USERNAMES 的播种账号）；
#     用户不可静音、不进 NOTIFY_CATEGORIES（唯一治理面 = NOTIFY_ENABLED）
#   - 只有**可被诱发**的 auth 臂真正吃额度（alert + recovery 都计）；availability 臂只计 alert，
#     recovery 免额；heartbeat 不计额。进程内计数、重启清零（与 L1/L2 同纪律）
#   - 超过上限的告警**丢弃 + 一条窗口聚合 WARN**（不落投递记录）；丢失后的补发上界 =
#     provider 内部重试 ≈3s + 下一次心跳（前 3 小时 ≤60min，之后 ≤240min）
#   ⚠️ 数值键写错（NaN / 非正数）会回落缺省并打一条 warning；不会静默关闭节流。
#
# ── 节流是**内存态**（别当成硬配额）──
#   L1 / L2 / 直发窗口 / 部署总闸都是**进程内内存**：每实例独立、**重启清零**、多副本部署
#   实际额度 ×N（无共享存储）。它们挡的是"批量刷屏"，不是精确计量。
#
# ── 生产 fail-fast（**二期起两组合**；dev 降级为 warning）──
#   ① `NOTIFY_ENABLED=false` ⇒ 不校验任何键
#   ② `ENABLED=true` + providers 含 `feishu` ⇒ `FEISHU_APP_ID` / `FEISHU_APP_SECRET` /
#      `NOTIFY_WEB_BASE_URL` **三键必填**
#   （一期曾有"③ categories 含 topic ⇒ OWNER_USERNAMES 必填"——二期撤除：收件人来自用户绑定，
#      owner 名单只作播种源，"有地址无归属"改由播种 outcome 在运行期按真实 DB 事实报错）
#   任何一条不满足：production 启动即崩（文案含"出境字段"与"如何关掉"）；dev/test 只打 warning。
#
# ── 生效自检（启用后按这几步对号入座）──
#   ① 生效自检：`docker compose logs backend | grep "notifications ENABLED"`
#      有这行 = 通知已装配（并打印 provider 列表、类别列表与出境字段清单）；没有 = 没生效。
#   ② owner 解析：`docker compose logs backend | grep "owner actors resolved"`
#      期望 `n/N` 且 n 等于你配的 username 个数；n < N = 有 username 没解析到（上面有逐个 warning）。
#   ③ 容器内键真的进去了吗：`docker compose exec backend printenv | grep -E 'NOTIFY_|FEISHU_'`
#      **逐键显式透传**是硬要求——往代码加键却漏加 compose 的行 = 容器里该键永远不存在。
#   ④ 一条也没收到？先看投递记录表（**抑制类不落表**：自回声 / 类别关 / 节流命中只在日志里，
#      表里没有 ≠ 没触发；排查靠 `grep "suppressed \["` 与 `grep "sending category="`）。
#
# ⚠️ **生产启用前先在 dev 实测一条**：飞书 provider 已是真身——开启后通知会**真的发到**你配的
#   私聊。凭据写错不会静默：第一条投递会以 `business: ... code=99991663` 的形态落进
#   `notification_deliveries`（该码 = 应用级鉴权被拒，`999916*` 一族都走这条分派），
#   排障入口 = 投递记录表 + 日志 `grep "sending category="` / `grep "feishu"`。
NOTIFY_ENABLED=false
NOTIFY_CATEGORIES=task_done,direct
NOTIFY_PROVIDERS=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_RECIPIENT_OPEN_ID=
NOTIFY_OWNER_USERNAMES=
# NOTIFY_WEB_BASE_URL=https://platform.example.com
NOTIFY_TASK_THROTTLE_SECONDS=300
NOTIFY_DOC_THROTTLE_SECONDS=600
NOTIFY_TOPIC_THROTTLE_SECONDS=600
NOTIFY_GLOBAL_RATE_LIMIT=5
NOTIFY_GLOBAL_RATE_WINDOW_SECONDS=600
NOTIFY_DIRECT_RATE_LIMIT_PER_WINDOW=6
NOTIFY_DIRECT_RATE_WINDOW_SECONDS=600
NOTIFY_PLATFORM_RATE_LIMIT=20
NOTIFY_PLATFORM_RATE_WINDOW_SECONDS=600
NOTIFY_HTTP_TIMEOUT_MS=8000
NOTIFY_SYSTEM_ALERT_MAX_PER_HOUR=12

# ── 检索调参旋钮（批次 1-c 标定终值；单源 = src/common/utils/search/search-tuning.ts）──
# 模块加载期求值（仅影响新进程）；非法值（NaN/非有限/非正数/非整数）一律回落缺省。
# SEARCH_TS_W1：ts 腿权重（ts_rank_cd × W1，flag 0）。默认 3.0（批次 1-d1 四格排序扫描
#   裁决：W1 2→3 召回 57.1%→61.2%、top3 49.0%→53.1%、MRR 0.455→0.473，W1=4 为平台期）；
#   合法域 = 正有限浮点。调后必须重跑评估集（改它会改 cd 尺度）。
#   注：弱命中 hint 线**已随本旋钮现构**（批次 1-d2 R4 落地：doc-search 侧 = 基准 0.3 × W1，
#   见 search-tuning.ts 的 DOC_SEARCH_WEAK_HIT_SCORE）——故 W1=3 下 cd 单点 0.1×3=0.3
#   仍 < 现构线 0.9，弱命中分支照常触发，无需再为它调整 W1 或改线为相对值。
# SEARCH_KGATE_K_OVERRIDE：K-gate K 覆盖值。缺省/空 = 不覆盖（≤4 CJK 字 K=1，更长 K=2）；
#   合法域 = 正整数（1.5 这类浮点视为写错回落不覆盖）。批次 1-c 实测 K 轴仅移动 1 条
#   打分条目 ⇒ 保持"不覆盖"规则。
# SEARCH_DF_DEGRADE_THRESHOLD：df 预检降级阈值（union-count 口径，sv @@ :compiledQ 候选集
#   行数上限，超过走常数分+位置序降级）。默认 20000（批次 1-c 四档扫描裁决，落在
#   8069~26224 平台段；p95 2283ms→1017ms、最坏 12100ms→2699ms）。
#   ⚠️ df 只计 ts 候选，不覆盖 trgm 位图 recheck 耗时的主因（见常量 doc）。
# SEARCH_TRGM_HEADING_W：doc-search 融合公式的 heading trgm 项权重（sim(heading,q)×W，
#   仅 doc-search；experience 侧不动）。默认 0.5（批次 1-d1 扫描裁决：0.8→0.5 召回 +2pp、
#   p95 降、en-identifier 名次改善）。合法域 = (0,1) 开区间——上界由地板三角
#   (0.6+W)×0.05 < 0.08 决定（W≥1 会让预过滤不再是地板命中集超集 = 静默丢召回），
#   ≥1 一律视同写错回落默认值 0.5（doc-search-constants.spec.ts 是警报器）。
SEARCH_TS_W1=3.0
SEARCH_KGATE_K_OVERRIDE=
SEARCH_DF_DEGRADE_THRESHOLD=20000
SEARCH_TRGM_HEADING_W=0.5
